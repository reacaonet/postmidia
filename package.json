{
  "name": "postmidia",
  "version": "0.1.0",
  "description": "SaaS multicliente de campanhas multicanal - core de publicacao com adapter pattern",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate": "ts-node --transpile-only src/db/migrate.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "verify:provider-specs": "ts-node --transpile-only scripts/verify-provider-specs.ts",
    "verify:dead-letter": "ts-node --transpile-only scripts/verify-dead-letter.ts",
    "verify:reconcile": "ts-node --transpile-only scripts/verify-reconcile.ts",
    "verify:metrics": "ts-node --transpile-only scripts/verify-metrics.ts",
    "verify:media": "ts-node --transpile-only scripts/verify-media.ts",
    "verify:templates": "ts-node --transpile-only scripts/verify-template-status.ts",
    "verify:queue": "ts-node --transpile-only scripts/verify-queue.ts",
    "dev:web": "npm --prefix web install --no-audit --no-fund && npm --prefix web run dev",
    "build:web": "npm --prefix web install --no-audit --no-fund && npm --prefix web run build",
    "typecheck:web": "npm --prefix web run typecheck"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "axios": "^1.6.0",
    "bullmq": "^6.3.9",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true,
  "license": "MIT"
}
