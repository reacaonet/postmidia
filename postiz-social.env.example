# Credenciais das redes sociais do Postiz.
#
# Este arquivo e montado em /app/.env DENTRO do container postiz. O backend e o
# orquestrador sobem com `dotenv -e ../../.env`, entao e este arquivo que eles
# leem — nao o `environment:` do docker-compose.yml. (Foi por isso que
# declarar as variaveis no compose nao resolvia: o Postiz nunca as via.)
#
# COMO USAR
#   1. Copie este arquivo:            cp postiz-social.env.example postiz-social.env
#   2. Preencha os valores.
#   3. Suba o stack:                  docker compose up -d postiz
#
# O `postiz-social.env` esta no .gitignore. Este `.example` e versionado e fica
# sem valor de proposito.
#
# REDIRECT URI (cadastre exatamente assim em cada painel do provedor):
#   http://localhost:4007/integrations/<provider>/callback
#
# Como o Postiz roda local, o redirect precisa ser http e localhost. O provedor
# recusa https em localhost, e um IP de LAN so funciona se o painel de cada rede
# aceitar.


# ---- LinkedIn ----
# https://www.linkedin.com/developers/apps -> seu app -> Authentication
# Products: "Sign In with LinkedIn" e/ou "Share on LinkedIn".
# Sem client_id valido a tela mostra:
#   The passed in client_id is invalid "undefined"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---- Telegram ----
# Fale com @BotFather no DM, mande /newbot, e ele devolve o token.
#
# O fluxo do Postiz manda "/connect <codigo>" no grupo e espera que VOCE responda
# "/connect" para o MESMO bot, dentro do grupo. Sem o token, nenhum bot le a sua
# resposta e o handshake nunca fecha — o codigo expira sem erro visivel.
TELEGRAM_BOT_TOKEN=

# ---- Instagram (Meta) ----
# https://developers.facebook.com -> seu app -> Instagram -> API setup
# Precisa de uma conta Business do Instagram ligada a uma Página do Facebook.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- Facebook (Meta) ----
# O mesmo app do Instagram costuma servir os dois.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Threads (Meta) ----
THREADS_APP_ID=
THREADS_APP_SECRET=

# ---- TikTok ----
# https://developers.tiktok.com -> seu app -> TikTok API for Business
# Aprovacao de conta(required) costuma levar dias.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- YouTube ----
# https://console.cloud.google.com -> APIs & Services -> Credentials.
# Habilite "YouTube Data API v3" ANTES de pedir a chave, senao o OAuth passa e
# a publicacao falha depois.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---- Google (YouTube usa as duas; Google nao e uma integracao separada no Postiz) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- X / Twitter ----
# https://developer.x.com -> Project -> OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=

# ---- Reddit ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- Discord ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- Pinterest ----
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ---- Mastodon ----
# Qualquer instancia com OAuth. Ajuste o redirect URI para o host da sua.
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# ---- Bluesky ----
# Protocolo AT: usuario e senha de APP (generate an app password). Nao use a
# senha da conta, ela vai para o repositorio.
BLUESKY_IDENTIFIER=
BLUESKY_PASSWORD=

# ---- Giphy (opcional) ----
# Sem isso o picker de GIF nao carrega, mas o resto funciona.
GIPHY_API_KEY=
